#!/bin/sh
# Enforce Conventional Commits.
msg=$(head -n1 "$1")
case "$msg" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: invalid message: $msg" >&2
  echo "Expected: <type>[(scope)]: <summary>" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
if grep -Eiq '^(co-authored-by|signed-off-by):|generated with|claude' "$1"; then
  echo "commit-msg: no co-author/sign-off trailers or AI attribution allowed." >&2
  exit 1
fi
if [ "$(grep -vc '^#' "$1")" -gt 4 ]; then
  echo "commit-msg: message too long; keep the subject and at most a short body." >&2
  exit 1
fi
if [ "${#msg}" -gt 100 ]; then
  echo "commit-msg: first line is over 100 characters." >&2
  exit 1
fi
exit 0
